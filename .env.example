# -----------------------------------------------------------------------
# Authentication & Internal Service Security (REQUIRED)
# -----------------------------------------------------------------------

# Independent keys for each caller/receiver pair. Generate with the bootstrap helper.
CLOUDFORGE_FRONTEND_PROJECT_KEY=replace-with-an-independent-key
CLOUDFORGE_FRONTEND_INFRASTRUCTURE_KEY=replace-with-an-independent-key
CLOUDFORGE_FRONTEND_DEPLOYMENT_KEY=replace-with-an-independent-key
CLOUDFORGE_FRONTEND_AIOPS_KEY=replace-with-an-independent-key
CLOUDFORGE_FRONTEND_FINOPS_KEY=replace-with-an-independent-key
CLOUDFORGE_AIOPS_DEPLOYMENT_KEY=replace-with-an-independent-key
CLOUDFORGE_ALERTMANAGER_KEY=replace-with-an-independent-key

# Frontend HMAC key for CSRF tokens derived from opaque sessions.
# Must be at least 32 bytes. Generate with:
#   openssl rand -base64 48 | tr -d '\n'
CLOUDFORGE_SESSION_SECRET=replace-with-a-different-secret-32-chars

# Set to "true" in production (HTTPS). Set to "false" for local HTTP.
CLOUDFORGE_AUTH_COOKIE_SECURE=false

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------


POSTGRES_PASSWORD=replace-with-a-local-development-password

# AWS Credentials (for real AWS infrastructure provisioning and FinOps monitoring)
# Option 1: Standard Access Keys (Recommended for Docker containers)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=  # optional, only needed for temporary STS/SSO session credentials
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Option 2: AWS Profile (uses ~/.aws mounted volume)
AWS_PROFILE=default

# EKS / Kubernetes Workload Deployment
EKS_CLUSTER_NAME=  # e.g. cloudforge-dev-eks
KUBERNETES_NAMESPACE=default

# FinOps Role
CLOUDFORGE_FINOPS_ROLE=platform-engineer
# Optional read-only DSN with SELECT on projects, project_members, infrastructure_resources and infrastructure_ec2_attribution.
FINOPS_PROJECT_DATABASE_URL=

# Grafana SMTP
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=

# Alertmanager SMTP
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=

# Bedrock requires an approved existing guardrail and a published numeric version.
# Leave blank when AI_PROVIDER is disabled; unconfigured Bedrock fails closed.
AI_BEDROCK_GUARDRAIL_ID=
AI_BEDROCK_GUARDRAIL_VERSION=
