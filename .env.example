# Database
POSTGRES_PASSWORD=replace-with-a-local-development-password

# AWS Credentials (for real AWS infrastructure provisioning and FinOps monitoring)
# Option 1: Standard Access Keys (Recommended for Docker containers)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=  # optional, only needed for temporary STS/SSO session credentials
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1

# Option 2: AWS Profile (uses ~/.aws mounted volume)
AWS_PROFILE=default

# FinOps Role
CLOUDFORGE_FINOPS_ROLE=platform-engineer

# Grafana SMTP
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=

# Alertmanager SMTP
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
